{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "webstack project settings (.claude/webstack.json)",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "definitions": {
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Argument array, never a shell string. {php} and {arg} are substituted where documented." },
    "globs": { "type": "array", "items": { "type": "string" }, "description": "Paths relative to the base folder; * matches within a segment, ** across segments." },
    "hook": {
      "type": "object",
      "required": ["name", "command"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "command": { "$ref": "#/definitions/command" },
        "timeoutSeconds": { "type": "number", "default": 120 }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "php": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": { "type": "string", "default": "PHP_BIN", "description": "Environment variable checked first for the PHP binary." },
        "candidates": { "type": "array", "items": { "type": "string" }, "description": "PHP binaries tried next; 'php' on PATH is tried last." }
      }
    },
    "release": {
      "type": "object",
      "required": ["dist", "zip"],
      "additionalProperties": false,
      "properties": {
        "lint": { "type": "array", "items": { "$ref": "#/definitions/command" } },
        "build": { "$ref": "#/definitions/command" },
        "dist": { "type": "string", "description": "Build output folder; must contain index.html." },
        "zip": { "type": "string", "pattern": "\\.zip$", "description": "Output path; {date} becomes YYYY-MM-DD." },
        "phpLint": { "$ref": "#/definitions/globs" },
        "mirrors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "copy"],
            "additionalProperties": false,
            "properties": { "source": { "type": "string" }, "copy": { "type": "string" }, "ignore": { "$ref": "#/definitions/globs" } }
          }
        },
        "exclude": { "$ref": "#/definitions/globs" },
        "required": { "type": "array", "items": { "type": "string" }, "description": "Zip entry paths that must be present." },
        "forbidden": { "$ref": "#/definitions/globs" }
      }
    },
    "apache": {
      "type": "object",
      "required": ["target", "baseUrl"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "description": "Throwaway test folder; must contain .webstack-test-target. Emptied before each copy." },
        "baseUrl": { "type": "string", "pattern": "^https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:\\d+)?(/|$)" },
        "neverTouch": { "type": "array", "items": { "type": "string" } }
      }
    },
    "urlChecks": {
      "type": "object",
      "required": ["checks"],
      "additionalProperties": false,
      "properties": {
        "forbiddenPaths": { "type": "array", "items": { "type": "string" }, "description": "Path fragments never requested (mail endpoints)." },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string", "description": "Appended to the base URL; may include a query string." },
              "method": { "enum": ["GET", "HEAD"] },
              "status": { "type": "integer", "default": 200 },
              "timeoutSeconds": { "type": "number" },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "additionalProperties": false,
                  "properties": { "name": { "type": "string" }, "regex": { "type": "string" }, "flags": { "type": "string" }, "absent": { "type": "boolean" } }
                }
              },
              "body": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "contains": { "type": "array", "items": { "type": "string" } },
                  "notContains": { "type": "array", "items": { "type": "string" } },
                  "regex": { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "type": "object", "required": ["pattern"], "properties": { "pattern": { "type": "string" }, "flags": { "type": "string" } } }] } },
                  "counts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["pattern"],
                      "additionalProperties": false,
                      "properties": { "pattern": { "type": "string" }, "flags": { "type": "string" }, "exact": { "type": "integer" }, "min": { "type": "integer" }, "max": { "type": "integer" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "emails": {
      "type": "object",
      "required": ["cases"],
      "additionalProperties": false,
      "properties": {
        "harness": { "$ref": "#/definitions/command", "description": "Custom harness instead of the built-in stub mailer; writes manifest.json to WEBSTACK_OUT." },
        "apiDir": { "type": "string" },
        "handlers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Case-name prefix -> handler file in apiDir." },
        "copy": { "type": "array", "items": { "type": "string" }, "description": "Helper files copied beside the handlers. Never the real mailer or config." },
        "mailerFile": { "type": "string", "default": "mailer.php" },
        "configFile": { "type": "string", "default": "config.php" },
        "mailerClass": { "type": "string", "default": "SimpleSmtpMailer" },
        "sendArgs": { "type": "array", "items": { "enum": ["to", "subject", "html", "text", "replyTo", "toName", "ignore"] }, "default": ["to", "subject", "html", "text", "replyTo", "toName"] },
        "stubConstants": { "type": "object", "description": "Constants the stub config defines (recipients, names). No credentials." },
        "cases": { "type": "string", "description": "Folder of <prefix>-<name>.json POST bodies." },
        "taint": { "type": "array", "items": { "type": "string" }, "description": "Strings from the cases that must never appear raw in HTML bodies." },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "case": { "type": "string", "description": "Glob on case names; default *." },
              "message": { "type": "integer", "minimum": 1 },
              "messages": { "type": "integer", "description": "Expected number of messages for each matching case." },
              "field": { "enum": ["to", "toName", "replyTo", "subject", "text", "html", "any"] },
              "contains": { "type": "array", "items": { "type": "string" } },
              "notContains": { "type": "array", "items": { "type": "string" } },
              "regex": { "type": "array", "items": { "type": "string" } },
              "ignoreCase": { "type": "boolean" }
            }
          }
        }
      }
    },
    "parity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "php", "ts"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "php": { "$ref": "#/definitions/command" },
          "ts": { "$ref": "#/definitions/command" },
          "defaultArg": { "type": "string" },
          "timeoutSeconds": { "type": "number" }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mustBeIgnored": { "type": "array", "items": { "type": "string" } },
        "allowTracked": { "$ref": "#/definitions/globs" },
        "secretPatterns": { "type": "array", "items": { "type": "string" }, "description": "Extended regexes that must not match tracked files." },
        "protectedUrls": { "type": "array", "items": { "type": "string" }, "description": "Paths that must return 401/403/404 on the local Apache copy." }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": { "type": "array", "items": { "$ref": "#/definitions/hook" } },
        "url-checks": { "type": "array", "items": { "$ref": "#/definitions/hook" } },
        "emails": { "type": "array", "items": { "$ref": "#/definitions/hook" } },
        "parity": { "type": "array", "items": { "$ref": "#/definitions/hook" } },
        "security": { "type": "array", "items": { "$ref": "#/definitions/hook" } }
      }
    }
  }
}
